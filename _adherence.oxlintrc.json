{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/core/**",
              "components/disclosure/**",
              "publish/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Zen Maru Gothic|Zen Kaku Gothic New|Quicksand))/i]",
        "message": "Font not provided by the design system. Available: Zen Maru Gothic, Zen Kaku Gothic New, Quicksand."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|category|date|title|excerpt|layout|onClick|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, category, date, title, excerpt, layout, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<ArticleCard> layout must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|children|disabled|fullWidth|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, children, disabled, fullWidth, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|text|underline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'text' | 'underline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:arrow-right|chevron-right)$/]",
        "message": "<Button> icon must be one of 'arrow-right' | 'chevron-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|body|cta|layout|onClick|key|ref|className|style|children)$/]",
        "message": "<ChoiceCard> doesn't accept that prop. Declared props: image, title, body, cta, layout, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<ChoiceCard> layout must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|body|layout|onClick|key|ref|className|style|children)$/]",
        "message": "<CompareCard> doesn't accept that prop. Declared props: image, title, body, layout, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:feature|row)$/]",
        "message": "<CompareCard> layout must be one of 'feature' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|defaultOpen|marker|compact|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer, defaultOpen, marker, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute[name.name='marker'] > Literal[value!=/^(?:q|chevron)$/]",
        "message": "<FaqItem> marker must be one of 'q' | 'chevron'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow-right|chevron-right|chevron-down|plus|minus|menu|x)$/]",
        "message": "<Icon> name must be one of 'arrow-right' | 'chevron-right' | 'chevron-down' | 'plus' | 'minus' | 'menu' | 'x'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:arrow-right|chevron-right|menu|x|plus)$/]",
        "message": "<IconButton> icon must be one of 'arrow-right' | 'chevron-right' | 'menu' | 'x' | 'plus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:coral|ghost)$/]",
        "message": "<IconButton> variant must be one of 'coral' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|size|src|showMark|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: layout, size, src, showMark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|inline)$/]",
        "message": "<Logo> layout must be one of 'stacked' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|rule|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, rule, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='rule'] > Literal[value!=/^(?:dash|lines|none)$/]",
        "message": "<SectionHeading> rule must be one of 'dash' | 'lines' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SectionHeading> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|peach|mint)$/]",
        "message": "<Tag> tone must be one of 'plain' | 'peach' | 'mint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:background|outline|outlineColor|amplitude|wavelength|radius|shadow|children|style|innerStyle|key|ref|className|style|children)$/]",
        "message": "<WaveFrame> doesn't accept that prop. Declared props: background, outline, outlineColor, amplitude, wavelength, radius, shadow, children, style, innerStyle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
